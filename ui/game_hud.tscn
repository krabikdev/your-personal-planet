[node name="IntroBody" type="Label" parent="Root/IntroPanel/Center/IntroBox/IntroMargin/IntroVBox"]
custom_minimum_size = Vector2(470, 0)
layout_mode = 2
mouse_filter = 2
text = "Тут майже нічого немає. Лише каміння, тиша і ти.

Стрибок на такій маленькій планеті сильніший за її гравітацію. Якщо стрибнути — можна полетіти в порожнечу й замерзнути.

Коли космічне сміття пролітає поруч, воно саме потрапляє в сачок — просто опинися там, де його можна дістати. Планета ростиме, а гравітація стане сильнішою.

Права кнопка мишки забиває кілок: канат не дасть відлетіти, а пробіл у повітрі підтягне тебе назад. Повторне натискання прибирає кілок разом з канатом."
horizontal_alignment = 1
autowrap_mode = 3

