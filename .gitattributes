# Line endings: store LF in the repository, check out LF everywhere.
# Windows editors are expected to respect this; do not commit CRLF.
* text=auto eol=lf

# Binary assets: never diff or merge them line by line.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary
*.gltf text
*.blend binary
*.exr binary
*.hdr binary
